# Copy this file to .env and fill in real values. .env is gitignored.
# Any channel left unset is simply skipped (logged + optional desktop popup
# always work regardless).

# --- Email (SMTP) notifications ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=app-password-here
SMTP_FROM=you@example.com
SMTP_TO=you@example.com
SMTP_USE_TLS=true

# --- SMS via a Termux gateway on your phone (see termux/README.md) ---
# If the phone is connected over USB tethering, leave SMS_GATEWAY_URL unset:
# its IP is auto-discovered from the USB interface's default route, so it
# survives the interface being renamed or the host's own IP changing across
# reconnects. Set it explicitly (e.g. if the phone is on Wi-Fi instead):
# SMS_GATEWAY_URL=http://<phone-ip>:8080/sms
SMS_GATEWAY_TOKEN=generate-a-random-token-and-put-the-same-value-on-the-phone
SMS_TO_NUMBER=+1234567890
